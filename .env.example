# ============================================================
# B-roll Video Engine — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
WORKERS=1

# --- Storage ---
ARTIFACTS_DIR=./artifacts
TEMP_DIR=./temp
MAX_UPLOAD_SIZE_MB=100

# --- Job Processing ---
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=600

# --- Footage Providers ---
# Set to "pexels" for real footage, "mock" for deterministic testing
FOOTAGE_PROVIDER=pexels
PEXELS_API_KEY=your_pexels_api_key_here

# --- TTS Provider ---
# Options: gtts (free, no key), elevenlabs
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=

# --- STT Provider ---
# Options: whisper (local), mock
STT_PROVIDER=whisper
WHISPER_MODEL=base

# --- Semantic Matching ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
MIN_RELEVANCE_THRESHOLD=0.25
SEMANTIC_WEIGHT=0.60
VISUAL_HINT_WEIGHT=0.20
DURATION_WEIGHT=0.10
ASPECT_RATIO_WEIGHT=0.10

# --- Video Rendering ---
# Presets: production, development (lower resolution for speed)
RENDER_PRESET=development
VIDEO_FPS=30
VIDEO_BITRATE=2000k
AUDIO_BITRATE=128k

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Callback HMAC (optional) ---
CALLBACK_HMAC_SECRET=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
